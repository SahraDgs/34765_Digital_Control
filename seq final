void sequenceFinal()
{
  bool button;
  static float circleStart = 0;

  switch (state)
  {
  case 0: // Wait for start
    button = digitalReadFast(PIN_START_BUTTON);
    if (button or robot.missionStart)
    {
      start();
      desiredValue = 0;
      desiredHeading = 0;
      endTime = time_sec + 0.020;
      state = 10;
    }
    break;

  case 10: // Start driving forward 1 m
    if (time_sec > endTime)
    {
      desiredValue = 0.65;
      //endTime = time_sec + 1.5;
      state = 101;
    }
    break;

  case 101: // Start 60 degree turn
    if (pose[0] >= 1.0f)
    {
      desiredValue = 0.0;
      desiredHeading = -60;
      endTime = time_sec + 1.0;
      state = 102;
    }
    break;

  case 102: // Start circle
    if (time_sec > endTime)
    {
      circleStart = pose[0];
      desiredValue = 0.45;
      state = 103;
    }
    break;


  case 103: // Follow circle
    {
      float radius = 0.5f;
      float distance = pose[0] - circleStart;

      desiredHeading = -60.0f + distance / radius * 180.0f / PI;

      if (desiredHeading >= 240.0f)
      {
        //desiredHeading = .0f;
        desiredValue = 0;
        endTime = time_sec + 0.5;
        state = 104;
      }
    }
    break;

  
  case 104: // Start 60 degree left turn
    if (time_sec > endTime)
    {
      desiredValue = 0.0;
      desiredHeading = 180.0f;
      endTime = time_sec + 1.0;
      state = 105;
  }
  break;

  case 105: // Start driving forward 1.5 m
    if (time_sec > endTime)
    {
      circleStart = pose[0];
      desiredValue = 0.65;
      state = 106;
    }
    break;

  case 106: // Stop after final forward movement
    if (pose[0] - circleStart >= 1.5f)
    {
      stop(0.5);
    }
    break;

  case 199: // Stop after final forward movement
    if (time_sec > endTime)
    {
      stop(0.5);
    }
    break;

  default: // Finish sequence
    if (time_sec > endTime)
      finished();
    break;
  }
}
